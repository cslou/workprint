{
  "name": "workprint",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.8",
  "devEngines": { "runtime": { "name": "node", "version": "24.22.1", "onFail": "download" } },
  "engines": { "node": "24.22.1", "pnpm": "11.28.8" },
  "scripts": {
    "build": "node scripts/tasks.mjs build",
    "dev": "node scripts/tasks.mjs dev",
    "start": "node scripts/tasks.mjs start",
    "db:prepare": "node scripts/tasks.mjs db:prepare",
    "db:local": "node scripts/local-database.mjs",
    "check": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/api-client/tsconfig.json && tsc --noEmit && tsc -p scripts/browser/tsconfig.json && eslint . && node scripts/boundaries.mjs && node scripts/boundary-controls.mjs",
    "test": "node scripts/test.mjs",
    "test:smoke": "node scripts/test.mjs smoke",
    "test:security": "node scripts/test.mjs security",
    "test:contracts": "node scripts/test.mjs contracts",
    "qualify:ingress": "node scripts/test.mjs ingress-qualification",
    "test:browser": "node scripts/test.mjs compile && playwright test --config scripts/browser/playwright.config.ts interaction.spec.ts config.spec.ts connectivity.spec.ts shell.spec.ts shell-admission.spec.ts chat.spec.ts question.spec.ts version.spec.ts",
    "test:visual": "playwright test --config scripts/browser/playwright.config.ts visual.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "mastra": "1.35.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
