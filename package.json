{
  "name": "workprint",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.8",
  "devEngines": { "runtime": { "name": "node", "version": "24.22.1", "onFail": "download" } },
  "engines": { "node": "24.22.1", "pnpm": "11.28.8" },
  "scripts": {
    "build": "node scripts/tasks.mjs build",
    "dev": "node scripts/tasks.mjs dev",
    "start": "node scripts/tasks.mjs start",
    "db:prepare": "node scripts/tasks.mjs db:prepare",
    "db:migrate": "node supabase/migrate.mjs",
    "db:local": "node scripts/local-database.mjs",
    "check": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/api-client/tsconfig.json && tsc -p packages/player/tsconfig.json && tsc --noEmit && tsc -p test/e2e/tsconfig.json && eslint . && node scripts/boundaries.mjs && node scripts/boundary-controls.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:tooling": "node scripts/test.mjs tooling",
    "test:integration": "node scripts/test.mjs integration",
    "test:browser": "node scripts/test.mjs compile && node scripts/test-stack.mjs playwright test --config test/e2e/playwright.config.ts",
    "live:chat": "node scripts/test.mjs compile && node scripts/test-stack.mjs node scripts/live/chat.mjs",
    "live:image": "node scripts/test.mjs compile && node scripts/live/image.mjs",
    "live:video": "node scripts/test.mjs compile && node scripts/live/video.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "supabase": "2.84.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
