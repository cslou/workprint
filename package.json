{
  "name": "workprint",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.8",
  "devEngines": { "runtime": { "name": "node", "version": "24.22.1", "onFail": "download" } },
  "engines": { "node": "24.22.1", "pnpm": "11.28.8" },
  "scripts": {
    "build": "node scripts/tasks.mjs build",
    "dev": "node scripts/tasks.mjs dev",
    "start": "node scripts/tasks.mjs start",
    "db:prepare": "node scripts/tasks.mjs db:prepare",
    "db:local": "node scripts/local-database.mjs",
    "check": "tsc -p packages/contracts/tsconfig.json && tsc --noEmit && eslint . && node scripts/boundaries.mjs && node scripts/boundary-controls.mjs",
    "test": "node scripts/test.mjs",
    "test:smoke": "node scripts/test.mjs smoke",
    "test:security": "node scripts/test.mjs security",
    "test:contracts": "node scripts/test.mjs contracts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "mastra": "1.35.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
