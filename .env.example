# Separately authorized dedicated development target; public browser values are explicitly marked.
# Never use a shared/customer target, commit real values, or prefix secrets with VITE_.
# For credential-free setup use: pnpm db:local (see README).
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Required provider/model identifier syntax; no live model/provider is enabled yet.
# Supply an actually qualified default when that integration is delivered.
# The isolated fixture supplies its own inert identifier; this file has no fake provider.
DEFAULT_ASSISTANT_MODEL=

PORT=4111
WEB_PORT=5173

# One Supabase Auth integration for every environment. HTTPS required except loopback.
# Use a publishable key or legacy anon key, NOT a service-role/admin key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Explicit public browser build/development values; never use a secret/admin key.
# Match the separately authorized Auth target above; rebuild after changes.
WORKPRINT_PUBLIC_API_ORIGIN=
WORKPRINT_PUBLIC_SUPABASE_URL=
WORKPRINT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exact Muse credential variables await real integration qualification.
# No R2/media credentials are required for the foundation.
