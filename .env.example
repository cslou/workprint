# Server-only, separately authorized dedicated development target.
# Never use a shared/customer target, commit real values, or prefix secrets with VITE_.
# For credential-free setup use: pnpm db:local (see README).
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Required provider/model identifier syntax; no live model/provider is enabled yet.
