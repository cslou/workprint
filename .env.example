# Server-only, separately authorized dedicated development target.
# Never use a shared/customer target, commit real values, or prefix secrets with VITE_.
# Use pnpm local:prepare for owned local Supabase; pnpm db:local is Auth-free.
# Generated private config lives under ignored outputs/ (see README).
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Required provider/model identifier syntax; no live model/provider is enabled yet.
# Supply an actually qualified default when that integration is delivered.
# The isolated fixture supplies its own inert identifier; this file has no fake provider.
DEFAULT_ASSISTANT_MODEL=

PORT=4111
WEB_PORT=5173

# Server-only actual Auth verification. A URL requires its key; never browser-exposed.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Local setup creates two synthetic local identities privately; never put accounts here.
# Exact Muse credential variables await real integration qualification.
# No R2/media credentials are required.
